{
  "name": "ghostthread",
  "version": "3.2.2",
  "private": false,
  "type": "module",
  "description": "GhostThread — Temporary Mode for Codex",
  "scripts": {
    "test": "node --test",
    "patch:vscode": "node patch.mjs --vscode",
    "restore:vscode": "node patch.mjs --uninstall --vscode",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run test:build",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:build": "npm run build && node scripts/verify-build.mjs"
  },
  "license": "MIT",
  "bin": {
    "ghostthread": "./build/ghostthread.mjs",
    "temp-codex": "./build/temp-codex.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "codex",
    "temporary-chat",
    "cli",
    "vscode"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
